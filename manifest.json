{
  "manifest_version": 3,
  "name": "Shopee Scraper",
  "version": "2.1",
  "description": "Batch-scrape Shopee store products and product reviews from your own logged-in browser. Saves per-page JSON and optionally POSTs each page to an API.",
  "permissions": ["storage", "tabs", "downloads"],
  "host_permissions": ["*://shopee.co.id/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee Scraper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://shopee.co.id/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://shopee.co.id/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
